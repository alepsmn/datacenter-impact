# Copia este archivo a .env y rellena los valores. .env NO se versiona.

# API key de EIA (https://www.eia.gov/opendata/register.php)
EIA_API_KEY=your_eia_api_key_here

# ID del proyecto de Google Cloud
GCP_PROJECT_ID=your_gcp_project_id_here

# --- Opcionales (tienen valor por defecto en scripts/config.py) ---

# Ventana temporal de la extracción EIA (YYYY-MM). El DAG de Airflow las
# inyecta desde sus `params`; aquí solo definen el valor por defecto local.
# EIA_START=2015-01
# EIA_END=2024-12
